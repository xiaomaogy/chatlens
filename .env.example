# ChatLens is a local-only dashboard — keep it bound to 127.0.0.1.
HOST=127.0.0.1
PORT=8090

# SQLite DB lives in ./data/.
DATABASE_URL=sqlite:///./data/chatlens.db

# Path to your local wechat-cli binary.
WECHAT_CLI_PATH=/Users/vincentgao/.local/bin/wechat-cli
WECHAT_CLI_CONFIG=

# Auto-open the dashboard in your default browser when you run `chatlens`.
AUTO_OPEN_BROWSER=true

# (Optional) path to the `claude` CLI. Defaults to `which claude`.
# CLAUDE_PATH=/Users/vincentgao/.local/bin/claude
